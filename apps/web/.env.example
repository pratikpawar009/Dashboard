# Frontend FastAPI base URL (PGD-01). Used for both the Program Detail page's
# server-rendered initial fetch and the client-side program-switcher reload
# (see apps/web/src/lib/apiConfig.ts::getApiBaseUrl()). Defaults to
# http://localhost:8000 when unset, matching docs/config/stack-smoke.md's
# fastapi-2/fastapi `Run:` port.
#
# Copy this file to .env.local for local dev: `cp .env.example .env.local`.
NEXT_PUBLIC_API_URL=http://localhost:8000
