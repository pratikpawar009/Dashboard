APP_NAME=dashboard-api
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dashboard
LOG_LEVEL=INFO

# OIDC (Keycloak). All four identity fields default to None (unset) — while
# any of client_id/client_secret/issuer is unset, /auth/login and
# /auth/callback return 501 and only /auth/dev-bypass is usable. Never put a
# real client secret here.
# Left EMPTY on purpose, not filled with a placeholder string: an empty value is
# what "unset" means to Settings.oidc_configured, so a straight
# `cp .env.example .env` reproduces the documented default-disabled (501) state.
# A non-empty placeholder would read as configured and send /auth/login redirecting
# to the real issuer with junk credentials. Fill both to go live.
#   OIDC_CLIENT_ID=dashboard-api
#   OIDC_CLIENT_SECRET=<from the Keycloak client's Credentials tab — never commit it>
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://lab.apexonlab.com/apexonlogin/realms/Apexon
OIDC_REALM=Apexon
# Optional (D-11). Set to the exact redirect URI registered on the Keycloak
# client when the API runs behind a reverse proxy or load balancer; left empty,
# the callback URL is derived from the incoming request, which is correct for
# local development but will mismatch a registered URI behind a proxy.
#
# Either way, the API's OWN callback must be a Valid Redirect URI on the client
# (http://localhost:8000/auth/callback locally). A frontend-style URI such as
# .../api/auth/callback/keycloak is not interchangeable: the code is exchanged
# server-side here, so the browser has to come back to the API.
OIDC_REDIRECT_URI=
# Every scope named here must exist on the realm AND be assigned to the client,
# or Keycloak rejects the whole authorization request with `invalid_scope` and
# sign-in fails before the login page is ever shown.
#
# `groups` is NOT one of Keycloak's built-in scopes. It needs a client scope of
# that name carrying a Group Membership mapper (token claim name `groups`, and
# "Full group path" OFF -- ON emits `/program-alpha`, whose leading slash makes
# every entry fail PROGRAM_GROUP_PREFIX matching, leaving `programs` silently
# empty with no error anywhere). Drop `groups` from this list only if you also
# accept that program membership will always be empty -- AUTH-03's program
# scoping depends on it.
OIDC_SCOPE="openid profile email groups"
PROGRAM_GROUP_PREFIX=program-
# Single origin, or a comma-separated list — no brackets/JSON array.
CORS_ORIGINS=http://localhost:3000
