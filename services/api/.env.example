APP_NAME=dashboard-api
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dashboard
LOG_LEVEL=INFO

# OIDC (Keycloak). All four identity fields default to None (unset) — while
# any of client_id/client_secret/issuer is unset, /auth/login and
# /auth/callback return 501 and only /auth/dev-bypass is usable. Never put a
# real client secret here.
# Left EMPTY on purpose, not filled with a placeholder string: an empty value is
# what "unset" means to Settings.oidc_configured, so a straight
# `cp .env.example .env` reproduces the documented default-disabled (501) state.
# A non-empty placeholder would read as configured and send /auth/login redirecting
# to the real issuer with junk credentials. Fill both to go live.
#   OIDC_CLIENT_ID=dashboard-api
#   OIDC_CLIENT_SECRET=<from the Keycloak client's Credentials tab — never commit it>
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://lab.apexonlab.com/apexonlogin/realms/Apexon
OIDC_REALM=Apexon
# Required for the frontend-first flow (AUTH-05). Left empty, the callback
# URL is derived from the incoming request, which resolves to the API's OWN
# /auth/callback (see _resolve_redirect_uri, app/auth/oidc.py) instead of the
# frontend's — Keycloak then sends the browser back to FastAPI, not Next.js,
# and the frontend never gets a chance to write the session cookie. Set this
# to the frontend's callback route so the browser lands there instead.
OIDC_REDIRECT_URI=http://localhost:3000/callback
#
# This is an ADDITIONAL redirect URI, not a replacement: the API's OWN
# callback must still be a Valid Redirect URI on the Keycloak client
# (http://localhost:8000/auth/callback locally). A frontend-style URI such as
# the one above is not interchangeable for THAT purpose — the code exchange
# for the API's own callback happens server-side here, so the browser must be
# able to reach the API directly too. Register both on the Keycloak client.
#
# Required for GET /auth/logout (AUTH-07): a FOURTH required value alongside
# the OIDC triple above -- unset, only THIS route returns 501, while
# /auth/login, /auth/callback, and /auth/refresh are unaffected. The
# frontend's own /login absolute URL, sent to Keycloak as
# post_logout_redirect_uri. NOT derived from OIDC_REDIRECT_URI above, which
# names a different route (/callback) -- set it separately even though both
# point at the same frontend origin locally.
FRONTEND_LOGIN_URL=http://localhost:3000/login
# Every scope named here must exist on the realm AND be assigned to the client,
# or Keycloak rejects the whole authorization request with `invalid_scope` and
# sign-in fails before the login page is ever shown.
#
# `groups` is deliberately NOT requested (AUTH-06). Program membership comes from
# `program_roster` -- each program's own committed roster file, ingested via
# POST /api/ingest/manifest -- not from a Keycloak group, so onboarding a program
# needs no realm administration. Adding `groups` back is safe if a deployment
# needs the raw claim for something else: `CurrentUser.groups` still populates
# verbatim whenever Keycloak sends it, it just no longer feeds `programs`. Doing
# so also means providing the client scope, since `groups` is not a Keycloak
# built-in.
OIDC_SCOPE="openid profile email"
# Single origin, or a comma-separated list — no brackets/JSON array.
CORS_ORIGINS=http://localhost:3000

# Persona resolution (AUTH-02). Three-tier fallthrough: Tier-1 (PERSONA_ROLE_MAP,
# below) -> Tier-2 YAML (services/api/config/persona_role_map.yaml) -> Tier-3
# Postgres persona_config (system of record). Valid personas: cio, architect,
# developer, product-manager, engineering-manager.
#
# Optional Tier-1 override: a JSON object mapping an IdP role claim to a
# persona. Left commented out on purpose, not set to an empty string: an unset
# var means Tier-1 is empty (not an error) and resolution falls through to
# Tier-2/3, whereas PERSONA_ROLE_MAP= (present but empty) fails JSON parsing
# and logs a warning on every startup. Invalid JSON, a non-object value, or an
# object with non-string values are likewise treated as empty -- a
# persona_role_map_parse_error warning is logged and resolution falls through
# to Tier-2/3. This fail-open parse behaviour is distinct from an unmapped
# role, which still raises once all three tiers come up empty.
#   PERSONA_ROLE_MAP={"cio":"cio","admin":"cio"}

# Optional Tier-2 YAML path override. Left commented out on purpose, not set to
# an empty string: PERSONA_CONFIG_FILE= resolves to Path(".") rather than
# None, which would replace PersonaResolver's own __file__-anchored default
# (services/api/config/persona_role_map.yaml) with the process's cwd. Unset,
# the resolver uses that anchored default regardless of cwd. Tier-2 is loaded
# once at process startup -- changing the YAML file's contents requires an app
# restart to take effect (no hot-reload in MVP).
#   PERSONA_CONFIG_FILE=/custom/path/to/persona_role_map.yaml

# Persona precedence order (AUTH-07-FR-6). Same three-tier fallthrough as
# above, one level up: Tier-1 (PERSONA_PRECEDENCE_ORDER, below) -> Tier-2
# (`precedence:` root-level key in services/api/config/persona_role_map.yaml)
# -> Tier-3 (Postgres persona_precedence table, ORDER BY rank). Picks a
# single deterministic winner when a token carries several mappable roles.
# All three unset falls back to the hardcoded default order (cio, architect,
# product-manager, engineering-manager, developer) -- no working deployment
# must configure this.
#
# Optional Tier-1 override: a JSON array of persona strings. Left commented
# out on purpose, same reasoning as PERSONA_ROLE_MAP above: unset means
# Tier-1 is empty (not an error) and resolution falls through to Tier-2/3,
# whereas PERSONA_PRECEDENCE_ORDER= (present but empty) fails JSON parsing
# and logs a warning on every startup. Invalid JSON, a non-array value, or
# an array with non-string elements are likewise treated as empty -- a
# persona_precedence_order_parse_error warning is logged and resolution
# falls through to Tier-2/3.
#   PERSONA_PRECEDENCE_ORDER=["cio","architect","product-manager","engineering-manager","developer"]
